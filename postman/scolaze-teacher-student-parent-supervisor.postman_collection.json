            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "عنوان معدّل", "type": "text" },
                { "key": "content", "value": "محتوى معدّل", "type": "text" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "الإعلانات — حذف (صاحب الإعلان أو أدمن)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/announcements/{{announcement_id}}", "host": ["{{base_url}}"], "path": ["announcements", "{{announcement_id}}"] }
          },
          "response": []
        },
        {
