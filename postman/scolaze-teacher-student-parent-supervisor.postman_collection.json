{
  "info": {
    "name": "Scolaze API — Student / Teacher / Parent / Supervisor",
    "description": "كل الـ endpoints الخاصة بأقسام الطالب، الأستاذ، الأهل، والموجه بتطبيق Scolaze. ما فيها مسارات الأدمن الحصرية (قسم منفصل عند الأدمن).\n\nطريقة الاستخدام:\n1. عدّل متغير base_url (Collection Variables) ليطابق رابط السيرفر عندك.\n2. نفّذ Login أو Parent Login من مجلد Auth.\n3. انسخ الـ token من الرد، وحطو بمتغير collection اسمو token (بدون كلمة Bearer).\n4. باقي الطلبات كلها عم تاخد الـ token تلقائياً (Bearer Auth عالـ collection).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000/api" },
    { "key": "token", "value": "" },
    { "key": "section_id", "value": "1" },
    { "key": "student_id", "value": "1" },
    { "key": "teacher_id", "value": "1" },
    { "key": "subject_id", "value": "1" },
    { "key": "homework_id", "value": "1" },
    { "key": "attendance_id", "value": "1" },
    { "key": "student_grade_id", "value": "1", "description": "id علامة الطالب (StudentGrade) — مو الصف الدراسي" },
    { "key": "class_grade_id", "value": "1", "description": "id الصف الدراسي (Grade — مثلاً العاشر) — مو العلامة" },
    { "key": "period_id", "value": "1" },
    { "key": "notification_id", "value": "1" },
    { "key": "announcement_id", "value": "1" },
    { "key": "year_id", "value": "1" },
    { "key": "message_id", "value": "1" },
    { "key": "supervisor_id", "value": "1" }
  ],
  "item": [
    {
      "name": "0) Auth",
      "item": [
        {
          "name": "Login (طالب / أستاذ)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"std_yousef123\",\n  \"password\": \"student123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "أي دور عندو username (طالب، أستاذ، موجه، أدمن). بيرجع token — احفظو بمتغير collection اسمو token."
          },
          "response": []
        },
        {
          "name": "Parent Login (كلمة سر بس)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/parent-login",
              "host": ["{{base_url}}"],
              "path": ["parent-login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"parent123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "دخول الأهل — كلمة سر بس بلا أي معرّف. كل ولي أمر إلو كلمة سر فريدة."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/logout", "host": ["{{base_url}}"], "path": ["logout"] }
          },
          "response": []
        },
        {
          "name": "بروفايلي (/me) — حسب الدور",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/me", "host": ["{{base_url}}"], "path": ["me"] },
            "description": "بيرجع البروفايل الكامل حسب دور المستخدم (طالب/أستاذ/أهل/موجه/أدمن) — اسم، صورة، صف/شعبة، أولاد (للأهل)، إلخ."
          },
          "response": []
        }
      ]
    },
    {
      "name": "1) مشترك بين كل الأدوار",
      "item": [
        {
          "name": "الإعلانات — لائحة (مفلترة حسب الدور)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/Annoucements", "host": ["{{base_url}}"], "path": ["Annoucements"] }
          },
          "response": []
        },
        {
          "name": "الإعلانات — إنشاء (أدمن أو أستاذ)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/Annoucements", "host": ["{{base_url}}"], "path": ["Annoucements"] },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "إعلان تجريبي", "type": "text" },
                { "key": "content", "value": "محتوى الإعلان هون", "type": "text" },
                { "key": "target_role", "value": "all", "type": "text", "description": "all | teachers | first_grade | second_grade | third_grade" },
                { "key": "type", "value": "normal", "type": "text", "description": "normal | urgent | important | activity | rule_policy | administrative | academic" },
                { "key": "image", "type": "file", "src": [] }
              ]
            }
          },
          "response": []
        },
        {
          "name": "الإعلانات — تعديل (صاحب الإعلان أو أدمن)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Accept", "value": "application/json" }],
